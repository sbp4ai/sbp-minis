<view class="bar">
  <view class="dot {{state}}"></view>
  <picker mode="selector" range="{{serverNames}}" value="{{serverIdx}}" bindchange="onSwitch" wx:if="{{serverNames.length}}">
    <view class="srv">{{(cfg && (cfg.name || cfg.url)) || '未配置服务器'}} <text class="caret">▾</text></view>
  </picker>
  <text class="srv" wx:else>{{(cfg && (cfg.name || cfg.url)) || '未配置服务器'}}</text>
  <text class="tip">{{tip}}</text>
  <text class="act {{loading ? 'spin' : ''}}" bindtap="reload">⟳</text>
</view>

<view class="empty" wx:if="{{!cfg}}">
  <view class="big">⚙</view>
  <view class="et">先配置服务器</view>
  <view class="muted">填好地址与密钥，才看得到机器上的 agent</view>
  <navigator url="/pages/settings/settings" class="btn" style="margin-top:36rpx">去配置</navigator>
</view>

<block wx:else>
  <view class="empty" wx:if="{{err}}">
    <view class="big">⚡</view>
    <view class="et">{{err}}</view>
    <view class="btn" style="margin-top:36rpx" bindtap="reload">重试</view>
  </view>

  <view class="empty" wx:elif="{{!groups.length && !loading}}">
    <view class="big">◌</view>
    <view class="et">没有活跃的 agent</view>
    <view class="muted">在电脑上 tmux 里跑起 claude / codex / dsh，这里就会出现</view>
    <view class="muted">没有 agent 的机器也能点进去，用空终端敲命令启动</view>
  </view>

  <view class="glist" wx:else>
    <view class="sum" wx:if="{{total}}">{{total}} 个活跃会话 · 只显示正在跑的 agent</view>
    <view class="group" wx:for="{{groups}}" wx:key="key">
      <!-- 只有一台机器时不重复报名字：顶部已经写了 -->
      <view class="ghead" bindtap="toggle" data-i="{{index}}" wx:if="{{groups.length > 1}}">
        <text class="caret">{{item.open ? '▾' : '▸'}}</text>
        <text class="gname">{{item.name}}</text>
        <text class="dot live" wx:if="{{item.live}}"></text>
        <text class="gnum">{{item.count}}</text>
        <text class="cwd mono">{{item.cwd}}</text>
      </view>
      <view class="items" wx:if="{{item.open}}">
        <view class="item {{it.shell ? 'shell' : ''}}" wx:for="{{item.items}}" wx:for-item="it" wx:key="sid"
              bindtap="open" data-sid="{{it.sid}}">
          <view class="avatar {{it.tag.cls}}">{{it.tag.letter}}</view>
          <view class="ibody">
            <view class="ititle">{{it.title}}</view>
            <view class="isub" wx:if="{{it.tmux || it.subtitle}}">
              <text class="itmux" wx:if="{{it.tmux}}">{{it.tmux}}</text>{{it.subtitle}}
            </view>
          </view>
          <view class="iright">
            <text class="pill {{it.shell ? 'idle' : 'run'}}">{{it.shell ? '待命' : (it.count ? it.count + ' 条' : '运行中')}}</text>
            <text class="itime" wx:if="{{it.time}}">{{it.time}}</text>
          </view>
          <text class="chev">›</text>
        </view>
      </view>
    </view>
  </view>
</block>
