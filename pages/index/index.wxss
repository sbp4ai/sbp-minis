/* 会话列表：一台机器一张卡，卡里只有「正在跑」的 agent 会话 */
.bar {
  display: flex;
  align-items: center;
  padding: 18rpx 24rpx;
  background: rgba(255, 255, 255, .92);
  border-bottom: 1rpx solid #eef1f5;
  position: sticky;
  top: 0;
  z-index: 9;
  backdrop-filter: blur(10px);
}
.dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: #d0d5dd;
  margin-right: 14rpx;
  flex: 0 0 auto;
}
.dot.open  { background: #12b76a; box-shadow: 0 0 0 6rpx rgba(18, 183, 106, .12); }
.dot.closed { background: #f79009; }
.dot.live  { background: #12b76a; margin: 0 10rpx; width: 12rpx; height: 12rpx; }

.srv { font-weight: 600; font-size: 28rpx; }
.srv .caret { color: #98a2b3; font-size: 20rpx; margin-left: 4rpx; }
.tip { color: #98a2b3; font-size: 22rpx; margin-left: 14rpx; flex: 1 1 auto;
  overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
.act { color: #2563eb; padding: 6rpx 10rpx; font-size: 30rpx; }
.act.spin { color: #98a2b3; }

.glist { padding: 8rpx 0 70rpx; }
.sum {
  color: #98a2b3;
  font-size: 21rpx;
  padding: 10rpx 32rpx 2rpx;
  letter-spacing: .02em;
}

.group {
  background: #fff;
  margin: 16rpx 24rpx;
  border-radius: 20rpx;
  overflow: hidden;
  box-shadow: 0 1rpx 2rpx rgba(16, 24, 40, .04);
}
.ghead {
  display: flex;
  align-items: center;
  padding: 20rpx 24rpx 16rpx;
}
.caret { color: #b6bdc9; width: 30rpx; font-size: 22rpx; }
.gname { font-weight: 650; font-size: 27rpx; letter-spacing: -.01em; }
.gnum {
  font-size: 19rpx;
  color: #667085;
  background: #f2f4f7;
  border-radius: 999rpx;
  padding: 1rpx 12rpx;
  margin-left: 12rpx;
}
.cwd {
  margin-left: auto;
  font-size: 20rpx;
  color: #b6bdc9;
  max-width: 250rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.items { padding: 0 16rpx 14rpx; }

.item {
  display: flex;
  align-items: center;
  padding: 18rpx 16rpx;
  border-radius: 16rpx;
  margin-bottom: 8rpx;
  background: #fbfcfe;
  border: 1rpx solid #f1f4f8;
}
.item:active { background: #f2f6ff; }
.item.shell { background: #fff; border-style: dashed; border-color: #e4e8ef; }

.avatar {
  width: 62rpx;
  height: 62rpx;
  border-radius: 18rpx;
  flex: 0 0 auto;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  font-weight: 800;
  background: #f2f4f7;
  color: #667085;
  margin-right: 18rpx;
}
.avatar.claude { background: linear-gradient(145deg, #fdf0e6, #fbe3d1); color: #b45309; }
.avatar.codex  { background: linear-gradient(145deg, #e8f7ef, #d5f0e2); color: #067647; }
.avatar.dsh    { background: linear-gradient(145deg, #ecebff, #dedbff); color: #5145cd; }
.avatar.qwen   { background: linear-gradient(145deg, #e8f1ff, #d7e6ff); color: #1d4ed8; }
.avatar.hermes { background: linear-gradient(145deg, #fdeef6, #fadfec); color: #b3226b; }
.avatar.shell  {
  background: #f7f8fa; color: #98a2b3; border: 1rpx dashed #dfe3ea;
  font-size: 20rpx; font-weight: 600;
}

.ibody { flex: 1 1 auto; min-width: 0; }
.ititle {
  font-size: 27rpx;
  font-weight: 620;
  color: #101828;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.item.shell .ititle { color: #475467; font-weight: 500; }
.isub {
  font-size: 22rpx;
  color: #98a2b3;
  margin-top: 4rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
/* 行内 tmux 名：这条会话挂在哪个 tmux 里 */
.itmux {
  display: inline-block;
  margin-right: 8rpx;
  padding: 0 8rpx;
  border-radius: 6rpx;
  background: #f2f4f7;
  color: #667085;
  font-size: 19rpx;
  font-family: "SF Mono", Menlo, Consolas, monospace;
}
.item.shell .isub { color: #b6bdc9; }

.iright { display: flex; flex-direction: column; align-items: flex-end; flex: 0 0 auto; margin-left: 12rpx; }
.pill {
  font-size: 19rpx;
  padding: 2rpx 12rpx;
  border-radius: 999rpx;
  line-height: 1.6;
}
.pill.run  { background: #e7f8ef; color: #067647; }
.pill.idle { background: #f2f4f7; color: #98a2b3; }
.itime { font-size: 19rpx; color: #b6bdc9; margin-top: 4rpx; }
.chev { color: #d0d5dd; font-size: 30rpx; margin-left: 6rpx; }

/* 空态 */
.empty { padding: 110rpx 56rpx; text-align: center; color: #98a2b3; }
.empty .big {
  width: 108rpx; height: 108rpx; line-height: 108rpx;
  margin: 0 auto 22rpx;
  border-radius: 32rpx;
  background: #fff;
  border: 1rpx solid #eef1f5;
  font-size: 46rpx;
  color: #b6bdc9;
}
.empty .et { font-size: 28rpx; color: #475467; margin-bottom: 10rpx; }
.empty .muted { display: block; font-size: 23rpx; line-height: 1.7; }
